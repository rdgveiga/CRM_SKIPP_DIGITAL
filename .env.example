# =============================================================================
# CRM Skipp Digital - Integração Meta Ads | Variáveis de ambiente
# Copie este arquivo para ".env" (root), "backend/.env" e "frontend/.env"
# e preencha com seus valores reais. NUNCA commite o .env.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (use em backend/.env e no painel da Vercel)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# URL pública do frontend (usada para redirecionar após o OAuth)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Meta for Developers -----------------------------------------------------
# App ID e App Secret do app em https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v22.0

# URL de callback do OAuth. Deve bater EXATAMENTE com a configurada no app.
# Local:   http://localhost:4000/api/meta/auth/callback
# Vercel:  https://<seu-projeto>.vercel.app/api/meta/auth/callback
META_REDIRECT_URI=http://localhost:4000/api/meta/auth/callback

# Permissões solicitadas no diálogo OAuth (separadas por vírgula)
META_SCOPE=pages_show_list,pages_read_engagement,ads_management,leads_retrieval

# Token de verificação do webhook (valor livre que você define aqui e também
# cola na tela de configuração do webhook no painel da Meta)
META_WEBHOOK_VERIFY_TOKEN=skipp-digital-meta-verify-token

# --- Supabase ----------------------------------------------------------------
# Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# -----------------------------------------------------------------------------
# FRONTEND (use em frontend/.env e também na Vercel, com prefixo VITE_)
# Somente URL e ANON KEY (seguros para expor). Use para o Realtime ao vivo.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=